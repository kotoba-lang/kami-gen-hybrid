{:paths ["src"]
 ;; Three `:local/root` deps per ADR-2607051130: `character` (deterministic
 ;; body/rig), `comfyui` (texture node-graph execution engine, renamed from
 ;; com-junkawasaki/comfyui-clj -- GitHub-transferred to kotoba-lang), `vrm`
 ;; (final .vrm assembly/export, renamed to org-vrmc-vrm). comfyui itself
 ;; depends on langchain (git dep, resolved transitively); the :dev alias
 ;; below overrides that to a local checkout for offline workspace
 ;; development, same convention as the "actor" repos (CLAUDE.md Actors
 ;; section).
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}io.github.kotoba-lang/character
        {:git/url "https://github.com/kotoba-lang/character.git"
                                     :git/sha "197410ae8fab61c2bc46c690fc6affbec046928f"}
        io.github.kotoba-lang/comfyui
        {:git/url "https://github.com/kotoba-lang/comfyui.git"
                                     :git/sha "d3e1c2e62eb2c4fade64583d676ea54090da115a"}
        io.github.kotoba-lang/org-vrmc-vrm
        {:git/url "https://github.com/kotoba-lang/org-vrmc-vrm.git"
                                     :git/sha "8d8725af2feb4666cfd9573a30cc879b5fd43878"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../langchain"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}